JWT_SECRET=env_development_local_secret_key
JWT_ALGORITHM=HS256
JWT_EXP_SECONDS=3600

SPRING_DATASOURCE_HIKARI_CONNECTION_TIMEOUT=30000
SPRING_DATASOURCE_HIKARI_IDLE_TIMEOUT=600000
SPRING_DATASOURCE_HIKARI_MAX_LIFETIME=1800000
SPRING_DATASOURCE_HIKARI_MAX_POOL_SIZE=10
SPRING_DATASOURCE_HIKARI_MIN_IDLE=5
SPRING_DATASOURCE_HIKARI_POOL_NAME=HikariPool-1
SPRING_DATASOURCE_HIKARI_VALIDATION_TIMEOUT=5000
SPRING_DATASOURCE_HIKARI_LEAK_DETECTION_THRESHOLD=2000
SPRING_DATASOURCE_HIKARI_AUTO_COMMIT=true
SPRING_DATASOURCE_HIKARI_READ_ONLY=false
SPRING_DATASOURCE_HIKARI_REGISTER_MBEANS=false
SPRING_DATASOURCE_HIKARI_ISOLATION=TRANSACTION_READ_COMMITTED
SPRING_DATASOURCE_HIKARI_TRANSACTION_ISOLATION=TRANSACTION_READ_COMMITTED

DATABASE_DSN=postgresql://localhost:5432/bookstore-auth-development
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
