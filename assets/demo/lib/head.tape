Set Shell bash
Set Width 1920
Set Height 1080
Set Padding 16
Set Framerate 30
Set TypingSpeed 45ms
Set Theme {"name":"Fuku Vivid","background":"#1e1e2e","foreground":"#eef0fa","cursor":"#f5e0dc","selection":"#45475a","black":"#45475a","red":"#ff5f6d","green":"#4ef08a","yellow":"#ffd75f","blue":"#5fafff","magenta":"#c77dff","cyan":"#2de2e6","white":"#d4d8e8","brightBlack":"#8a8fa8","brightRed":"#ff6e7a","brightGreen":"#5cff95","brightYellow":"#ffe066","brightBlue":"#74b9ff","brightMagenta":"#d68cff","brightCyan":"#4ff0f0","brightWhite":"#ffffff"}

Hide
Type "exec /tmp/fuku-demo/start.sh"
Enter
Sleep 12s
Show
