---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getPluginsNav } from "../../data/nav";

const base = import.meta.env.BASE_URL;
const current = `${base}plugins/`;
const nav = getPluginsNav(base);
---

<DocsLayout
  title="Plugins - fuku"
  description="IDE and AI agent plugins for fuku service orchestrator."
  current={current}
  nav={nav}
  section="plugins"
>
  <h1>Plugins</h1>
  <p class="lead">Bring fuku into your IDE or your AI agent. Monitor services, read logs, and control your stack from the tools you already use.</p>

  <div class="card-grid two">
    <a href={`${base}plugins/jetbrains/`} class="card">
      <div class="card-num">01</div>
      <div class="card-icon">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <rect width="28" height="28" rx="5" fill="var(--text)"/>
          <text x="4" y="21" font-family="var(--heading)" font-size="14" font-weight="700" fill="var(--bg)">JB</text>
        </svg>
      </div>
      <h3>JetBrains</h3>
      <p>GoLand, IntelliJ IDEA, WebStorm, and all JetBrains IDEs. Service dashboard, log streaming, run configurations, and keyboard-driven control.</p>
      <span class="card-link">Learn more &rarr;</span>
    </a>

    <a href={`${base}plugins/agents/`} class="card">
      <div class="card-num">02</div>
      <div class="card-icon">
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
          <rect width="28" height="28" rx="5" fill="var(--text)"/>
          <text x="4" y="21" font-family="var(--heading)" font-size="14" font-weight="700" fill="var(--bg)">AI</text>
        </svg>
      </div>
      <h3>AI Agents</h3>
      <p>Claude Code and Codex. Seven MCP tools and two skills let the agent run a profile in the background, read bounded logs, and manage services.</p>
      <span class="card-link">Learn more &rarr;</span>
    </a>

    <div class="card coming-soon">
      <div class="card-num">03</div>
      <h3>VS Code</h3>
      <p>Coming soon. Service panel, log viewer, and command palette integration for Visual Studio Code.</p>
      <span class="card-badge">Planned</span>
    </div>
  </div>
</DocsLayout>

<style>
  .coming-soon {
    opacity: 0.6;
  }

  .card-icon {
    margin: 4px 0;
  }

  .card-badge {
    font-family: var(--mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    margin-top: auto;
    padding-top: 8px;
  }
</style>
