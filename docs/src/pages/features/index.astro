---
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getFeatures } from "../../data/features";
import { getFeaturesNav } from "../../data/nav";

const base = import.meta.env.BASE_URL;
const current = `${base}features/`;
const features = getFeatures(base);
const nav = getFeaturesNav(base);

const kickers = ["01", "02", "03", "04", "05", "06", "07"];
---

<DocsLayout
  title="Features - fuku"
  description="Detailed feature documentation for fuku."
  current={current}
  nav={nav}
  section="features"
>
  <h1>Features</h1>
  <p class="lead">What fuku does for your local services, from the first start to the last stop. Each feature has its own page and a recorded demo.</p>

  <div class="card-grid">
    {features.map((f, i) => (
      <a href={f.href} class="card">
        <div class="card-num">{kickers[i]}</div>
        <h3>{f.title}</h3>
        <p>{f.description}</p>
        <span class="card-link">Learn more &rarr;</span>
      </a>
    ))}
  </div>
</DocsLayout>
