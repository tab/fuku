---
import HeroAgentDemo from "./HeroAgentDemo.astro";

const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero-text">
    <h1 class="title">
      All services <span class="title-accent">one terminal</span>
    </h1>
    <p class="description">
      Lightweight CLI tool for running and managing multiple local services.
      Tier-based startup, readiness checks, hot reload and a live TUI from one
      YAML file. AI agents drive it through MCP.
    </p>
    <div class="actions">
      <a href={`${base}docs/getting-started/`} class="btn btn-primary">Get Started <span class="arrow">&rarr;</span></a>
      <a
        href="https://github.com/tab/fuku"
        target="_blank"
        rel="noopener"
        class="btn btn-ghost"
      >
        GitHub
      </a>
      <span class="install-cmd">$ brew install tab/apps/fuku</span>
    </div>
  </div>
  <div class="hero-visual">
    <HeroAgentDemo />
  </div>
</section>

<style>
  .hero {
    padding: 64px 24px 96px;
    max-width: 1320px;
    margin: 0 auto;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-visual {
    margin-top: 56px;
    animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
  }

  .title {
    font-family: var(--heading);
    font-weight: 600;
    font-size: clamp(2.5rem, 5.4vw, 4.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    margin: 0;
    color: var(--text);
    animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both;
  }

  .title-accent {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 0.94em;
    letter-spacing: -0.05em;
    color: var(--blue);
  }

  .description {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 640px;
    margin: 22px 0 0;
    animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  .actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    margin-top: 28px;
    flex-wrap: wrap;
    animation: fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.3s both;
  }

  .install-cmd {
    font-family: var(--mono);
    font-size: 0.8125rem;
    padding: 12px 14px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: var(--text);
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 18px;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.15s, opacity 0.15s;
  }

  .btn:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .btn-primary {
    background: var(--text);
    color: var(--bg);
  }

  .btn-ghost {
    background: var(--bg-card);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .btn-ghost:hover {
    border-color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 40px 16px 48px;
    }

    .hero-visual {
      margin-top: 40px;
    }
  }
</style>
